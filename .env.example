# Local: Ollama and the existing local account store.
# Preview/Production: supabase, with demo or gemini. Keep separate environments.
WENSHAN_ACCOUNT_BACKEND=local
WENSHAN_AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# WENSHAN_ACCOUNTS_DATA=.work/wenshan-account-db
# WENSHAN_ACCOUNT_ORIGIN=https://your-site.example
# WENSHAN_RELEASE=local

# Hosted runtime. Supply each value in the server environment only.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_AUTH_ADMIN_KEY=
# WENSHAN_DATABASE_URL=postgresql://wenshan_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# WENSHAN_DATABASE_CA=  # Official Supabase PEM certificate, including line breaks.
# WENSHAN_DB_SSL=disable
# WENSHAN_DB_SSL=disable is for disposable loopback PostgreSQL only.

# Gemini. Set the app caps below the project limits shown in Google AI Studio.
# A cap of 0 pauses cloud calls. A configured key alone will not activate Gemini.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LIMIT_PER_MINUTE=5
GEMINI_LIMIT_PER_DAY=40
GEMINI_USER_LIMIT_PER_MINUTE=2
GEMINI_USER_LIMIT_PER_DAY=5

# Vercel Production only. Set to true after the owner confirms first launch.
# WENSHAN_ALLOW_PRODUCTION=false

# Offline migration CLI only. Do not set it on Vercel.
# WENSHAN_MIGRATION_DATABASE_URL=
